int main(void)
{
    char msg[64];
    uint8_t reg = 0x00;
    uint8_t data[2];

    GPIO_PeriClockControl(GPIOA, ENABLE);
    GPIO_PeriClockControl(GPIOB, ENABLE);

    USART2_GPIOInit();
    USART2_Init();
    USART_PeripheralControl(USART2, ENABLE);

    USART_SendData(&usart2_handle,
                   (uint8_t*)"LM75 Address Scan Start\r\n",
                   strlen("LM75 Address Scan Start\r\n"));

    I2C1_GPIOInit();

    GPIOB->AFR[1] &= ~((0xFU << 0) | (0xFU << 4));
    GPIOB->AFR[1] |=  ((0x4U << 0) | (0x4U << 4));

    I2C1_Init();

    I2C_PeripheralControl(I2C1, ENABLE);
    I2C_ManageAcking(I2C1, I2C_ACK_ENABLE);

    delay_ms(100);

    for(uint8_t addr = 0x48; addr <= 0x4F; addr++)
    {
        data[0] = 0;
        data[1] = 0;

        sprintf(msg,
                "\r\nTesting Address 0x%02X\r\n",
                addr);

        USART_SendData(&usart2_handle,
                       (uint8_t*)msg,
                       strlen(msg));

        I2C_MasterSendData(&i2c1_handle,
                           &reg,
                           1,
                           addr,
                           I2C_ENABLE_SR);

        delay_ms(10);

        I2C_MasterReceiveData(&i2c1_handle,
                              data,
                              2,
                              addr,
                              I2C_DISABLE_SR);

        sprintf(msg,
                "MSB = 0x%02X  LSB = 0x%02X\r\n",
                data[0],
                data[1]);

        USART_SendData(&usart2_handle,
                       (uint8_t*)msg,
                       strlen(msg));

        delay_ms(100);
    }

    USART_SendData(&usart2_handle,
                   (uint8_t*)"\r\nScan Complete\r\n",
                   strlen("\r\nScan Complete\r\n"));

    while(1)
    {
    }
}
