/*
 * stm32f446xx_spi_driver.c
 * SPI implementation for Master Mode data streaming
 */

#include "stm32f446xx_spi_driver.h"

void SPI1_Init(void)
{
    // Enable APB2 Clock Gating for SPI1 (Bit 12)
    RCC->APB2ENR |= (1 << 12);

    uint32_t tempreg = 0;

    tempreg |= (1 << 2);   // MSTR = 1 : Configure STM32 as SPI Master
    tempreg |= (0 << 11);  // DFF = 0  : 8-bit Data Frame Format
    tempreg |= (0 << 1);   // CPOL = 0 : Clock idles LOW
    tempreg |= (0 << 0);   // CPHA = 0 : Sampling occurs on first clock edge
    tempreg |= (1 << 9);   // SSM = 1  : Enable Software Slave Management
    tempreg |= (1 << 8);   // SSI = 1  : Drive Internal Slave Select bit HIGH
    tempreg |= (0x3 << 3); // BR = 011 : Set Baud Rate (PCLK2 divided by 16)

    SPI1->CR1 = tempreg;
}

void SPI_PeripheralControl(SPI_RegDef_t *pSPIx, uint8_t EnOrDi)
{
    if(EnOrDi == ENABLE)  { pSPIx->CR1 |=  (1 << 6); } // SPE = 1
    else                 { pSPIx->CR1 &= ~(1 << 6); }
}

void SPI_SendData(SPI_RegDef_t *pSPIx, uint8_t *pTxBuffer, uint32_t Len)
{
    while(Len > 0)
    {
        while( ! (pSPIx->SR & (1 << 1)) ); // Wait for TXE (Transmit Buffer Empty) flag
        pSPIx->DR = *pTxBuffer;
        pTxBuffer++;
        Len--;
    }
}

void SPI_ReceiveData(SPI_RegDef_t *pSPIx, uint8_t *pRxBuffer, uint32_t Len)
{
    while(Len > 0)
    {
        while( ! (pSPIx->SR & (1 << 0)) ); // Wait for RXNE (Receive Buffer Not Empty) flag
        *pRxBuffer = pSPIx->DR;
        pRxBuffer++;
        Len--;
    }
}
