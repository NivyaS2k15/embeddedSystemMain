#include "stm32f446xx_spi_driver.h"

void SPI1_Init(void)
{
    SPI1_PCLK_EN();

    SPI1->CR1 = 0;

    SPI1->CR1 |= (1 << 2);
    SPI1->CR1 |= (1 << 9);
    SPI1->CR1 |= (1 << 8);

    SPI1->CR1 |= (0x5 << 3);
}

void SPI_PeripheralControl(SPI_RegDef_t *pSPIx, uint8_t EnOrDi)
{
    if(EnOrDi == ENABLE)
    {
        pSPIx->CR1 |= (1 << 6);
    }
    else
    {
        pSPIx->CR1 &= ~(1 << 6);
    }
}

void SPI_SendData(
        SPI_RegDef_t *pSPIx,
        uint8_t *pTxBuffer,
        uint32_t Len)
{
    while(Len > 0)
    {
        while(!(pSPIx->SR & (1 << 1)));

        pSPIx->DR = *pTxBuffer;

        pTxBuffer++;
        Len--;
    }

    while(pSPIx->SR & (1 << 7));
}

void SPI_ReceiveData(
        SPI_RegDef_t *pSPIx,
        uint8_t *pRxBuffer,
        uint32_t Len)
{
    while(Len > 0)
    {
        while(!(pSPIx->SR & (1 << 0)));

        *pRxBuffer = pSPIx->DR;

        pRxBuffer++;
        Len--;
    }
}
