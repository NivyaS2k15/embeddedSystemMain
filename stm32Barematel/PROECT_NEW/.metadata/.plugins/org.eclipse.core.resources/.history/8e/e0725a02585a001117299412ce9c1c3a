/*
 * i2c_lcd.c
 * Custom I2C LCD Driver Implementation
 */

#include "i2c_lcd.h"

extern void delay_ms(uint32_t ms);

/*
 * Helper function to send a 4-bit nibble over I2C and pulse the Enable pin
 */
static void LCD_SendNibble(I2C_Handle_t *pI2CHandle, uint8_t nibble, uint8_t rs_bit)
{
    uint8_t data_frame;

    // Formulate the frame: High 4 bits = Data, Low 4 bits = Control flags (Backlight ON)
    data_frame = (nibble & 0xF0) | rs_bit | LCD_PIN_BACKLIGHT;

    // 1. Assert data frame with Enable HIGH
    data_frame |= LCD_PIN_EN;
    I2C_MasterSendData(pI2CHandle, &data_frame, 1, LCD_SLAVE_ADDR, I2C_DISABLE_SR);
    delay_ms(1); // Short pulse setup delay

    // 2. Clear Enable LOW to latch data into LCD internal registers
    data_frame &= ~LCD_PIN_EN;
    I2C_MasterSendData(pI2CHandle, &data_frame, 1, LCD_SLAVE_ADDR, I2C_DISABLE_SR);
    delay_ms(2); // Execution wait time
}

void LCD_SendCommand(I2C_Handle_t *pI2CHandle, uint8_t cmd)
{
    // For commands, RS bit is strictly 0
    uint8_t high_nibble = cmd & 0xF0;
    uint8_t low_nibble = (cmd << 4) & 0xF0;

    LCD_SendNibble(pI2CHandle, high_nibble, 0);
    LCD_SendNibble(pI2CHandle, low_nibble, 0);
}

void LCD_SendData(I2C_Handle_t *pI2CHandle, uint8_t data)
{
    // For text data display, RS bit is strictly 1 (LCD_PIN_RS)
    uint8_t high_nibble = data & 0xF0;
    uint8_t low_nibble = (data << 4) & 0xF0;

    LCD_SendNibble(pI2CHandle, high_nibble, LCD_PIN_RS);
    LCD_SendNibble(pI2CHandle, low_nibble, LCD_PIN_RS);
}

void LCD_Init(I2C_Handle_t *pI2CHandle)
{
    // Power-on sequence initialization delay
    delay_ms(50);

    // Step into 4-Bit Interface mode configuration blocks
    LCD_SendNibble(pI2CHandle, 0x30, 0);
    delay_ms(5);
    LCD_SendNibble(pI2CHandle, 0x30, 0);
    delay_ms(1);
    LCD_SendNibble(pI2CHandle, 0x30, 0);
    delay_ms(10);

    LCD_SendNibble(pI2CHandle, 0x20, 0); // Activate 4-bit mode layout
    delay_ms(10);

    // Display Configurations
    LCD_SendCommand(pI2CHandle, LCD_CMD_FUNCTION_SET | 0x08); // 2 lines, 5x8 font size layout
    LCD_SendCommand(pI2CHandle, LCD_CMD_DISPLAY_CONTROL | LCD_DISPLAY_ON | LCD_CURSOR_OFF | LCD_BLINK_OFF);
    LCD_SendCommand(pI2CHandle, LCD_CMD_ENTRY_MODE_SET | 0x02); // Increment cursor right automatically

    LCD_Clear(pI2CHandle);
}

void LCD_SendString(I2C_Handle_t *pI2CHandle, char *str)
{
    while(*str)
    {
        LCD_SendData(pI2CHandle, (uint8_t)*str++);
    }
}

void LCD_SetCursor(I2C_Handle_t *pI2CHandle, uint8_t row, uint8_t col)
{
    uint8_t address = (row == 0) ? col : (0x40 + col);
    LCD_SendCommand(pI2CHandle, LCD_CMD_DDRAM_ADDR | address);
}

void LCD_Clear(I2C_Handle_t *pI2CHandle)
{
    LCD_SendCommand(pI2CHandle, LCD_CMD_CLEAR_DISPLAY);
    delay_ms(5); // Clearing the display screen requires a longer layout delay
