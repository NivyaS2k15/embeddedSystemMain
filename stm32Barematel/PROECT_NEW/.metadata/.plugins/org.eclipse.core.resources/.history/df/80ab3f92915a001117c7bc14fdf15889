#include "stm32f446xx_spi_driver.h"

void SPI1_Init(void)
{
    // Enable SPI1 clock
    SPI1_PCLK_EN();

    uint32_t tempreg = 0;

    // Master mode
    tempreg |= (1 << SPI_CR1_MSTR);

    // Baud rate = fPCLK/64
    tempreg |= (0x5 << SPI_CR1_BR);

    // CPOL = 0
    tempreg &= ~(1 << SPI_CR1_CPOL);

    // CPHA = 0
    tempreg &= ~(1 << SPI_CR1_CPHA);

    // Full duplex
    tempreg &= ~(1 << SPI_CR1_BIDIMODE);

    // Software slave management enable
    tempreg |= (1 << SPI_CR1_SSM);

    // Internal slave select
    tempreg |= (1 << SPI_CR1_SSI);

    // 8-bit data frame
    tempreg &= ~(1 << SPI_CR1_DFF);

    SPI1->CR1 = tempreg;
}

void SPI_PeripheralControl(SPI_RegDef_t *pSPIx, uint8_t EnOrDi)
{
    if(EnOrDi == ENABLE)
    {
        pSPIx->CR1 |= (1 << SPI_CR1_SPE);
    }
    else
    {
        pSPIx->CR1 &= ~(1 << SPI_CR1_SPE);
    }
}

uint8_t SPI_SendData(SPI_RegDef_t *pSPIx, uint8_t *pTxBuffer, uint32_t Len)
{
    uint32_t timeout = 100000;

    while(Len > 0)
    {
        while(!(pSPIx->SR & SPI_TXE_FLAG))
        {
            if(--timeout == 0)
                return 0;
        }

        pSPIx->DR = *pTxBuffer;

        pTxBuffer++;
        Len--;
    }

    while(pSPIx->SR & SPI_BUSY_FLAG);

    return 1;
}

uint8_t SPI_ReceiveData(SPI_RegDef_t *pSPIx, uint8_t *pRxBuffer, uint32_t Len)
{
    uint32_t timeout = 100000;

    while(Len > 0)
    {
        while(!(pSPIx->SR & SPI_RXNE_FLAG))
        {
            if(--timeout == 0)
                return 0;
        }

        *pRxBuffer = pSPIx->DR;

        pRxBuffer++;
        Len--;
    }

    return 1;
}

void SPI_ClearOVRFlag(SPI_RegDef_t *pSPIx)
{
    uint8_t temp;

    temp = pSPIx->DR;
    temp = pSPIx->SR;

    (void)temp;
}
