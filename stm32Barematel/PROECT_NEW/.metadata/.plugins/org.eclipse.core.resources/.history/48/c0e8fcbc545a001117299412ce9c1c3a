/*
 * main.c
 * Author: NIVYA
 * Description: Uses custom I2C and USART drivers to initialize a BMP280 sensor,
 * read calibration coefficients, and print real-time temperature over UART.
 * Includes explicit hardware register overrides to bypass driver bugs.
 */

#include <stdio.h>
#include <string.h>
#include "stm32f446xx.h"
#include "stm32f446xx_gpio_driver.h"
#include "stm32f446xx_usart_driver.h"
#include "stm32f446xx_i2c_driver.h"

// BMP280 I2C Target Definitions
#define BMP280_SLAVE_ADDR     0x77   // Swapped to 0x77 to test alternative onboard address routing
#define BMP280_REG_ID         0xD0   // ID register (Should return 0x58)
#define BMP280_REG_CTRL_MEAS  0xF4   // Control and measurement register
#define BMP280_REG_TEMP_MSB   0xFA   // First byte of raw temperature data

USART_Handle_t usart2_handle;
I2C_Handle_t   i2c1_handle;

/* * Global Calibration Coefficients structure for BMP280
 * These are required to calculate the true temperature.
 */
uint16_t dig_T1;
int16_t  dig_T2;
int16_t  dig_T3;

void delay_ms(uint32_t ms)
{
    for(uint32_t i = 0; i < (ms * 1000); i++);
}

void USART2_GPIOInit(void)
{
    GPIO_Handle_t usart_gpios = {0};
    usart_gpios.pGPIOx = GPIOA;
    usart_gpios.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_ALTFN;
    usart_gpios.GPIO_PinConfig.GPIO_PinOPType = GPIO_OP_TYPE_PP;
    usart_gpios.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_PIN_PU;
    usart_gpios.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_HIGH;
    usart_gpios.GPIO_PinConfig.GPIO_PinAltFunMode = 7;

    // PA2 -> TX, PA3 -> RX
    usart_gpios.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_2;
    GPIO_Init(&usart_gpios);
    usart_gpios.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_3;
    GPIO_Init(&usart_gpios);
}

void USART2_Init(void)
{
    usart2_handle.pUSARTx = USART2;
    usart2_handle.USART_Config.USART_Baud = USART_STD_BAUD_115200;
    usart2_handle.USART_Config.USART_HWFlowControl = USART_HW_FLOW_CTRL_NONE;
    usart2_handle.USART_Config.USART_Mode = USART_MODE_TXRX;
    usart2_handle.USART_Config.USART_ParityControl = USART_PARITY_DISABLE;
    usart2_handle.USART_Config.USART_NoOfStopBits = USART_STOPBITS_1;
    usart2_handle.USART_Config.USART_WordLength = USART_WORDLEN_8BITS;
    USART_Init(&usart2_handle);
}

void I2C1_GPIOInit(void)
{
    GPIO_Handle_t i2c_gpios = {0};
    i2c_gpios.pGPIOx = GPIOB;
    i2c_gpios.GPIO_PinConfig.GPIO_PinMode = GPIO_MODE_ALTFN;
    i2c_gpios.GPIO_PinConfig.GPIO_PinOPType = GPIO_OP_TYPE_OD;      // Open-Drain mode
    i2c_gpios.GPIO_PinConfig.GPIO_PinPuPdControl = GPIO_PIN_PU;    // Internal pull-ups
    i2c_gpios.GPIO_PinConfig.GPIO_PinSpeed = GPIO_SPEED_HIGH;
    i2c_gpios.GPIO_PinConfig.GPIO_PinAltFunMode = 4;               // AF4 for I2C1

    // PB8 -> SCL, PB9 -> SDA
    i2c_gpios.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_8;
    GPIO_Init(&i2c_gpios);
    i2c_gpios.GPIO_PinConfig.GPIO_PinNumber = GPIO_PIN_NO_9;
    GPIO_Init(&i2c_gpios);
}

void I2C1_Init(void)
{
    i2c1_handle.pI2Cx = I2C1;
    i2c1_handle.I2C_Config.I2C_SCLSpeed = I2C_SCL_SPEED_SM;
    i2c1_handle.I2C_Config.I2C_DeviceAddress = 0x20;
    i2c1_handle.I2C_Config.I2C_AckControl = I2C_ACK_ENABLE;

    // Toggle the APB1 clock gating for I2C1 BEFORE writing configurations
    I2C_PeriClockControl(I2C1, ENABLE);

    I2C_Init(&i2c1_handle);
}

void I2C_ApplicationEventCallback(I2C_Handle_t *pI2CHandle, uint8_t AppEv)
{
    // Empty callback
}

/* * Reads calibration data from BMP280 non-volatile memory space
 */
void BMP280_ReadCalibration(void)
{
    uint8_t calib_data[6] = {0};
    uint8_t reg_addr = 0x88;

    I2C_MasterSendData(&i2c1_handle, &reg_addr, 1, BMP280_SLAVE_ADDR, I2C_ENABLE_SR);
    I2C_MasterReceiveData(&i2c1_handle, calib_data, 6, BMP280_SLAVE_ADDR, I2C_DISABLE_SR);

    dig_T1 = (uint16_t)((calib_data[1] << 8) | calib_data[0]);
    dig_T2 = (int16_t)((calib_data[3] << 8) | calib_data[2]);
    dig_T3 = (int16_t)((calib_data[5] << 8) | calib_data[4]);
}

/* * Compensation formula from Bosch Datasheet
 */
int32_t BMP280_Compensate_T(int32_t adc_T)
{
    int32_t var1, var2, T;
    var1 = ((((adc_T >> 3) - ((int32_t)dig_T1 << 1))) * ((int32_t)dig_T2)) >> 11;
    var2 = (((((adc_T >> 4) - ((int32_t)dig_T1)) * ((adc_T >> 4) - ((int32_t)dig_T1))) >> 12) * ((int32_t)dig_T3)) >> 14;

    T = var1 + var2;
    return (T * 5 + 128) >> 8;
}

int main(void)
{
    uint8_t tx_buf[2];
    uint8_t rx_buf[3];
    char uart_log[60];

    // Enable Peripheral Clocks for GPIO Blocks
    GPIO_PeriClockControl(GPIOA, ENABLE);
    GPIO_PeriClockControl(GPIOB, ENABLE);

    // Initialize USART2 for Serial Terminal Logging
    USART2_GPIOInit();
    USART2_Init();
    USART_PeripheralControl(USART2, ENABLE);

    // Clear screen indicator print
    USART_SendData(&usart2_handle, (uint8_t*)"\r\n--- BMP280 Sensor Core Active ---\r\n", 37);

    // Initialize I2C1 for BMP280 Sensor Communications
    I2C1_GPIOInit();

    // BARE-METAL BAKE IN: Directly force PB8 and PB9 alternate functions into AFR High Register
    // This removes any potential driver assignment bugs for pins above index 7.
    GPIOB->AFR[1] &= ~( (0xFU << 0) | (0xFU << 4) ); // Clear bits for Pin 8 and Pin 9
    GPIOB->AFR[1] |=  ( (0x4U << 0) | (0x4U << 4) ); // Directly bind AF4 (I2C1) to Pin 8 and Pin 9

    I2C1_Init();
    I2C_PeripheralControl(I2C1, ENABLE);

    // DIAGNOSTIC BUS CHECK: Check if the STM32 registers see a locked or shorted I2C bus line
    if (I2C1->SR2 & (1 << 1)) // SR2 Bit 1 is BUSY flag
    {
        USART_SendData(&usart2_handle, (uint8_t*)"[DIAGNOSTIC]: I2C bus reports BUSY condition on boot!\r\n", 55);
    }

    // 1. Initialize BMP280 into Normal Mode, Over-sampling x1 for Temp
    tx_buf[0] = BMP280_REG_CTRL_MEAS;
    tx_buf[1] = 0x23;
    I2C_MasterSendData(&i2c1_handle, tx_buf, 2, BMP280_SLAVE_ADDR, I2C_DISABLE_SR);

    // 2. Fetch non-volatile factory calibration constants
    BMP280_ReadCalibration();

    while(1)
    {
        // 3. Set read pointer targeting raw temperature data space registers
        uint8_t reg_temp_addr = BMP280_REG_TEMP_MSB;
        I2C_MasterSendData(&i2c1_handle, &reg_temp_addr, 1, BMP280_SLAVE_ADDR, I2C_ENABLE_SR);

        // 4. Collect 3 bytes of raw data (MSB, LSB, XLSB)
        I2C_MasterReceiveData(&i2c1_handle, rx_buf, 3, BMP280_SLAVE_ADDR, I2C_DISABLE_SR);

        // 5. Build raw 20-bit ADC integer values
        int32_t adc_raw_temp = (int32_t)(((uint32_t)rx_buf[0] << 12) | ((uint32_t)rx_buf[1] << 4) | ((uint32_t)rx_buf[2] >> 4));

        // 6. Run compensation algorithm calculations
        int32_t fine_temp = BMP280_Compensate_T(adc_raw_temp);

        // 7. Parse the fixed point integers into display formats (e.g., 2453 -> 24.53)
        int32_t integer_part = fine_temp / 100;
        int32_t fractional_part = fine_temp % 100;
        if(fractional_part < 0) fractional_part = -fractional_part;

        sprintf(uart_log, "BMP280 Temperature: %ld.%02ld C\r\n", integer_part, fractional_part);
        USART_SendData(&usart2_handle, (uint8_t*)uart_log, strlen(uart_log));

        delay_ms(2000);
    }
    return 0;
}
